# Environment Configuration Template
# Copy this to .env and update with your values

# Flask Environment
ENVIRONMENT=development
# ENVIRONMENT=production

# Secret Key (generate a random string for production)
SECRET_KEY=your-secret-key-change-this-in-production

# Database Configuration
# Local SQLite (default fallback if DATABASE_URL is not set):
# DATABASE_URL=sqlite:///attendance_system.db

# Supabase PostgreSQL (replace [PROJECT-REF], [PASSWORD], and [REGION] with your Supabase credentials):
# Connection Pooler (Session mode - Recommended):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Direct connection:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Face Recognition Settings
RECOGNITION_THRESHOLD=0.55
COOLDOWN_SECONDS=10
ATTENDANCE_ALERT_THRESHOLD=75

# Flask Settings
FLASK_DEBUG=True
# FLASK_DEBUG=False (for production)
